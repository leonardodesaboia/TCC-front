{
  "expo": {
    "name": "AllSet",
    "slug": "allset-mobile",
    "scheme": "allset",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.allset.mobile"
    },
    "android": {
      "package": "com.allset.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O AllSet usa sua localização para encontrar pedidos Express próximos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O AllSet usa sua galeria para você enviar fotos do serviço, documentos e foto de perfil.",
          "cameraPermission": "O AllSet usa a câmera para você tirar fotos do serviço, documentos e foto de perfil.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B35"
        }
      ]
    ]
  }
}
